# Direct (unpooled) Neon connection string - used by the worker and the LangGraph checkpointer
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Read-only role connection string (agent_ro) - used only by the agent's run_sql tool
AGENT_RO_URL=postgresql://agent_ro:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# LLM Configuration
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
MODEL=openai/gpt-oss-120b
